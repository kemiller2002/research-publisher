{
  "name": "research-publisher",
  "project": "Research Publisher",
  "rosVersion": "3.0.3",
  "repSpecificationVersion": "2.0",
  "profile": "greenfield",
  "bootstrap": "BOOTSTRAP.md",
  "canonicalRoots": {
    "journals": "research/journals",
    "packages": "research/packages",
    "theories": "research/theories",
    "evidence": "research/evidence"
  },
  "registries": "registries",
  "templates": "templates",
  "generated": "generated",
  "repository": {"id": "research-publisher", "type": "application"},
  "workProtocol": {
    "version": "1.0.0",
    "enforceAttribution": true,
    "semanticMapping": {"ready": "ready", "active": "active", "blocked": "blocked", "complete": "complete"},
    "completionEvidence": {"default": ["implementation", "tests"], "research": ["research-record"], "mechanical": []},
    "meaningfulPaths": ["**"],
    "ignoredPaths": [".git/**", ".ros/context/**", ".ros/events/**", ".ros/work/**", "registries/**"]
  }
}

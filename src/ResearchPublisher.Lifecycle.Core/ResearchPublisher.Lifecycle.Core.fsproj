<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>ResearchPublisher.Lifecycle.Core</AssemblyName>
    <RootNamespace>ResearchPublisher.Lifecycle.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Files.fs" />
    <Compile Include="Package.fs" />
    <Compile Include="Manifest.fs" />
    <Compile Include="Desired.fs" />
    <Compile Include="Inspection.fs" />
    <Compile Include="Plan.fs" />
    <Compile Include="Migrations.fs" />
    <Compile Include="Planning.fs" />
    <Compile Include="Execution.fs" />
    <Compile Include="Verification.fs" />
    <Compile Include="Diagnostics.fs" />
    <Compile Include="Api.fs" />
  </ItemGroup>

</Project>

---
import "../styles/index.css";
import { withBasePath } from "../utils/paths";

const { title, description, site, navItems = [] } = Astro.props;
const homeHref = withBasePath(site.baseUrl, "/");
const siteTitleWords = String(site.title ?? "")
  .trim()
  .split(/\s+/)
  .filter(Boolean);
if (siteTitleWords.at(-1)?.toLowerCase() === "research" && siteTitleWords.length > 1) {
  siteTitleWords.pop();
}
const siteMark = siteTitleWords
  .map((word) => word.match(/[\p{L}\p{N}]/u)?.[0] ?? "")
  .join("")
  .toUpperCase() || "RP";
const buildGeneratedAt = site.buildGeneratedAt ?? null;
const buildGeneratedAtDate = buildGeneratedAt ? new Date(buildGeneratedAt) : null;
const buildGeneratedAtLabel =
  buildGeneratedAtDate && !Number.isNaN(buildGeneratedAtDate.getTime())
    ? `${new Intl.DateTimeFormat("en-US", {
        dateStyle: "medium",
        timeStyle: "medium",
        timeZone: "UTC"
      }).format(buildGeneratedAtDate)} UTC`
    : buildGeneratedAt;
const currentPath = Astro.url.pathname;
const basePath = site.baseUrl === "/" ? "" : site.baseUrl.replace(/\/$/, "");
const currentRoute = basePath && currentPath.startsWith(basePath)
  ? currentPath.slice(basePath.length) || "/"
  : currentPath;
const isCurrent = (href) => {
  return href === "/" ? currentRoute === "/" : currentRoute.startsWith(href);
};
---

<!doctype html>
<html lang={site.language ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:inline set:html={Object.entries(site.branding?.cssVariables ?? {}).map(([key, value]) => `${key}:${value};`).join("") ? `:root{${Object.entries(site.branding?.cssVariables ?? {}).map(([key, value]) => `${key}:${value};`).join("")}}` : ""}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <div class="site-identity">
          <span class="site-mark" aria-hidden="true">{siteMark}</span>
          <div>
          <a class="site-title" href={homeHref}>{site.title}</a>
            <p class="site-description">An open index of evidence, theory, and practice</p>
          </div>
        </div>
        <nav aria-label="Primary">
          <ul class="site-nav">
            {navItems.map((item) => (
              <li><a href={withBasePath(site.baseUrl, item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p><strong>{site.title}</strong></p>
      <p>Research made navigable, verifiable, and reusable.</p>
      {buildGeneratedAtLabel ? (
        <p class="site-build-stamp">
          Build: <time datetime={buildGeneratedAt}>{buildGeneratedAtLabel}</time>
        </p>
      ) : null}
    </footer>
  </body>
</html>

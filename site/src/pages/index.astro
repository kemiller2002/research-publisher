---
import BaseLayout from "../layouts/BaseLayout.astro";
import DocumentCard from "../components/DocumentCard.astro";
import { catalog, collections, siteData } from "../utils/data";
import { withBasePath } from "../utils/paths";

const navItems = [
  { href: "/search/", label: "Search" },
  { href: "/collections/artifact-type/", label: "Collections" }
];
const recentDocuments = [...catalog.records]
  .sort((left, right) => right.updated.localeCompare(left.updated))
  .slice(0, 6);
---

<BaseLayout title={siteData.site.title} description={siteData.site.description} site={siteData.site} navItems={navItems}>
  <section class="hero">
    <div class="hero__copy">
      <p class="site-kicker">Visual Engineering research archive</p>
      <h1>Find the thinking<br />behind the work.</h1>
      <p class="lede">Explore a living corpus of evidence, experiments, concepts, and working theories about how visual systems help people understand and act.</p>
      <div class="hero-actions">
        <a class="button" href={withBasePath(siteData.site.baseUrl, "/search/")}>Search all research <span aria-hidden="true">→</span></a>
        <a class="text-link" href={withBasePath(siteData.site.baseUrl, "/collections/artifact-type/")}>Browse by collection</a>
      </div>
    </div>
    <dl class="stats-panel">
      <div><dd>{siteData.summary.totalDocuments}</dd><dt>Documents indexed</dt></div>
      <div><dd>{Object.keys(collections.artifactTypes).length}</dd><dt>Artifact types</dt></div>
      <div><dd>{Object.keys(collections.researchAreas).length}</dd><dt>Research areas</dt></div>
    </dl>
  </section>

  <section class="feature-grid" aria-labelledby="explore-heading">
    <div class="section-heading">
      <p class="site-kicker">Explore the corpus</p>
      <h2 id="explore-heading">Follow the shape of the research</h2>
    </div>
    <article>
      <p class="feature-number" aria-hidden="true">01</p>
      <h3>By artifact</h3>
      <p>Move from raw evidence and research notes to hypotheses and durable theory.</p>
      <a href={withBasePath(siteData.site.baseUrl, "/collections/artifact-type/")}>View artifact types <span aria-hidden="true">→</span></a>
    </article>
    <article>
      <p class="feature-number" aria-hidden="true">02</p>
      <h3>By area</h3>
      <p>Trace related work across composition, publishing, evidence, and human factors.</p>
      <a href={withBasePath(siteData.site.baseUrl, "/collections/research-area/")}>View research areas <span aria-hidden="true">→</span></a>
    </article>
    <article>
      <p class="feature-number" aria-hidden="true">03</p>
      <h3>By status</h3>
      <p>Separate early drafts and active investigations from completed findings.</p>
      <a href={withBasePath(siteData.site.baseUrl, "/collections/status/")}>View research status <span aria-hidden="true">→</span></a>
    </article>
  </section>

  <section class="page-intro page-intro--split">
    <div>
    <p class="site-kicker">Recently updated</p>
      <h2>Latest from the archive</h2>
    </div>
    <a class="text-link" href={withBasePath(siteData.site.baseUrl, "/search/")}>Search the full index</a>
  </section>
  <section class="card-grid">
    {recentDocuments.map((document) => <DocumentCard document={document} baseUrl={siteData.site.baseUrl} />)}
  </section>
</BaseLayout>

---
import { catalog, siteData } from "../../utils/data";
import { withBasePath } from "../../utils/paths";

export function getStaticPaths() {
  return catalog.records.flatMap((document) =>
    (document.legacyUrls ?? [])
      .filter((url) => url.startsWith("/research/"))
      .map((url) => ({
        params: { slug: url.replace(/^\/research\//, "").replace(/\/$/, "") },
        props: { document }
      }))
  );
}

const { document } = Astro.props;
const target = withBasePath(siteData.site.baseUrl, document.url);
---
<!doctype html>
<html lang={siteData.site.language ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{document.title}</title>
  </head>
  <body>
    <p>This research document has a stable address. <a href={target}>Continue to {document.title}</a>.</p>
  </body>
</html>
